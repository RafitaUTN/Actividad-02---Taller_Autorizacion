meta {
  name: Listado administrador
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/estudiantes
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
}

tests {
  test("admin consulta los cinco registros de prueba", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.have.lengthOf(5);
  });
}

script:post-response {
  const records = res.getBody().data || [];
  const variablesByName = {
    "Ana": "estudiante1Id",
    "Luis": "estudiante2Id",
    "María": "estudiante3Id",
    "Carlos": "estudiante4Id",
    "Sofía": "estudiante5Id"
  };

  for (const record of records) {
    const variable = variablesByName[record.nombre];
    if (variable) bru.setEnvVar(variable, String(record.id));
  }
}
