meta {
  name: Listado estudiante
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/estudiantes
}

headers {
  Accept: application/json
  Authorization: Bearer {{estudianteToken}}
}

tests {
  test("estudiante autenticado consulta el listado general", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.have.lengthOf(5);
  });
}
