meta {
  name: Listado coordinador
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/estudiantes
}

headers {
  Accept: application/json
  Authorization: Bearer {{coordinadorToken}}
}

tests {
  test("coordinador autenticado consulta el listado general", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.have.lengthOf(5);
  });
}
