meta {
  name: Listado profesor
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/estudiantes
}

headers {
  Accept: application/json
  Authorization: Bearer {{profesorToken}}
}

tests {
  test("profesor autenticado consulta el listado general", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.have.lengthOf(5);
  });
}
