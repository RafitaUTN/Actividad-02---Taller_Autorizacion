meta {
  name: Estudiante consulta su registro inactivo
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/estudiantes/{{estudiante5Id}}
}

headers {
  Accept: application/json
  Authorization: Bearer {{estudianteInactivoToken}}
}

tests {
  test("propietario puede consultar su registro inactivo", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().activo).to.equal(false);
  });
}
