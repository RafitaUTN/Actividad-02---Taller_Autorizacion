meta {
  name: Listado autenticado sin rol
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/estudiantes
}

headers {
  Accept: application/json
  Authorization: Bearer {{temporalToken}}
}

tests {
  test("cuenta autenticada sin rol consulta el listado general", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.have.lengthOf(5);
  });
}
