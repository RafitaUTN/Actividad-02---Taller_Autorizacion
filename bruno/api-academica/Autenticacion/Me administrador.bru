meta {
  name: Me administrador
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/me
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
}

tests {
  test("token administrador autentica", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().user.email).to.equal("admin@academica.test");
  });
}
