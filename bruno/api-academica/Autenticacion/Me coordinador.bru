meta {
  name: Me coordinador
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/me
}

headers {
  Accept: application/json
  Authorization: Bearer {{coordinadorToken}}
}

tests {
  test("coordinador conserva su rol y permisos RBAC", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.user.roles.map((role) => role.name)).to.include("coordinador");
    expect(body.permissions).to.include("estudiantes.ver");
    expect(body.permissions).to.include("estudiantes.editar");
  });
}
